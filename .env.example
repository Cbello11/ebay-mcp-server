# ─── eBay API Credentials ─────────────────────────────────────────────────────
# Get these from: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=your-app-id-here
EBAY_CLIENT_SECRET=your-cert-id-here

# ─── eBay User Token (Seller write operations) ────────────────────────────────
# Generate via: https://developer.ebay.com/my/auth?env=production&index=0
# Scopes needed: sell.inventory, sell.fulfillment, sell.account, sell.marketing,
#                sell.feedback, post-order
EBAY_USER_TOKEN=v^1.1#i^1#...your-user-token-here...

# ─── eBay Marketplace ─────────────────────────────────────────────────────────
EBAY_MARKETPLACE=EBAY_US

# ─── Sandbox mode (set to "true" for testing) ─────────────────────────────────
EBAY_SANDBOX=false

# ─── MCP Server Auth (optional — set a secret to require Bearer token) ────────
MCP_AUTH_TOKEN=

# ─── Port (Railway sets this automatically) ───────────────────────────────────
PORT=3000
