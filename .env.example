# eBay Developer Credentials — set these in Railway dashboard
# Get them from: developer.ebay.com → My Account → Application Access Keys

EBAY_APP_ID=YourName-AppName-PRD-xxxxxxxxx-xxxxxxxx
EBAY_CERT_ID=PRD-xxxxxxxxxxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EBAY_DEV_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EBAY_USER_TOKEN=v^1.1#i^1#...

# Set to "true" to use eBay sandbox (testing). Leave unset or "false" for production.
EBAY_SANDBOX=false

# Port — Railway sets this automatically. Do not change.
PORT=3000

# Optional: Set a secret token to protect your MCP endpoint
# MCP_AUTH_TOKEN=your-secret-token-here
